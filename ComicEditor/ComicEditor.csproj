<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="..\signing\desktop-public.pem" LogicalName="ComicEditor.DesktopSigningKey" />
    <EmbeddedResource Include="..\licenses\QoiFu-MIT.txt" LogicalName="ComicEditor.QoiFu" />
    <EmbeddedResource Include="..\licenses\QOA-MIT.txt" LogicalName="ComicEditor.QOA" />
    <EmbeddedResource Include="..\third_party\AvaloniaColorPicker\LICENSE" LogicalName="ComicEditor.LGPL" />
    <EmbeddedResource Include="..\third_party\AvaloniaColorPicker\LICENSE.GPL" LogicalName="ComicEditor.GPL" />
    <InternalsVisibleTo Include="ComicEditor.Rendering.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- Match Avalonia desktop/native Skia; browser host selects its own WASM version. -->
    <PackageReference Include="SkiaSharp" VersionOverride="3.119.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="IconPacks.Avalonia.Material" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ComicEditor.Format\ComicEditor.Format.csproj" />
    <ProjectReference Include="..\third_party\AvaloniaColorPicker\AvaloniaColorPicker.csproj" />
  </ItemGroup>
</Project>
