<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ComicEditor.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ComicEditor.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ComicEditor.Views.MainWindow"
        Width="1280" Height="800" MinWidth="720" MinHeight="520"
        Title="ComicEditor" Icon="/Assets/comic-editor.ico">
        <views:MainView />
</Window>
